---
// Startseite: Sonnensystem, das sich endlos in die Radix verwandelt und zurück.
// Folgt der Ansicht der Seite (hell oder dunkel). Erfundene Konstellation, gehört zu keiner realen Person.
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/500.css';
import '@fontsource/noto-sans-symbols/400.css';
import '@fontsource/noto-sans-symbols-2/400.css';

interface Props {
  class?: string;
  /* Sprache der Tierkreisnamen, z. B. "en". Ohne Angabe gilt das lang der Seite. */
  lang?: string;
  /* Verwandlung folgt dem Scrollen durch den umgebenden Abschnitt statt der Uhr:
     beim Runterscrollen wird aus der Radix einmal das Sonnensystem */
  scroll?: boolean;
  /* Ab welcher Überschrift die Verwandlung beginnt (CSS-Selektor im Abschnitt), sonst ab Abschnittsbeginn */
  scrollStart?: string;
  /* Beim Öffnen läuft vorneweg der Kosmos-Film (Remotion), danach bleibt die Live-Radix stehen und dreht sich */
  film?: boolean | 'flug';
}
const { class: className, lang, scroll = false, scrollStart, film = false } = Astro.props;
/* film: true = Kosmos-Film (Sonnensystem → Radix), "flug" = Kosmos-Flug (Milchstraße → Erde → Radix) */
const filmArt = film === 'flug' ? 'flug' : film ? 'kosmos' : undefined;
---

<div class:list={['radix', className]} data-kosmos data-sprache={lang} data-scroll={scroll ? '' : undefined} data-scroll-start={scrollStart} data-film={filmArt}></div>

<script>
  import { baueSzene } from '../scripts/kosmos/szene';
  import { layout, aszendent, ASC0, type Richtungen } from '../scripts/kosmos/layout';
  import { schritt, phase, glatt, tempo, EINSTIEG, TEMPO_SEITE, type Uhr } from '../scripts/kosmos/zeitplan';
  import { sprache } from '../scripts/kosmos/texte';
  import { FILM_FPS, filmLaenge, filmUhren, filmLayout, filmPhase } from '../scripts/kosmos/film';
  import { FLUG_FPS, flugSeite } from '../scripts/kosmos/flug';
  import type { Layout } from '../scripts/kosmos/layout';

  /* Die beiden Filme: was die Seite über jeden wissen muss, um ihn zu spielen und danach live weiterzumachen */
  /* maske: Video doppelt so hoch mit mitgelieferter Deckkraft (Dateien mit -alpha), dann bleiben auch dunkle,
     undurchsichtige Stellen deckend und der Film darf eine eigene Nachtfläche mitbringen */
  interface Film { quelle: string; laenge: number; fps: number; layout(b: number): Layout; uhr(b: number): Uhr; phase(b: number): number; art: string; maske?: boolean }
  const FILME: Record<string, Film> = {
    kosmos: { art: 'kosmos', quelle: 'kosmos', laenge: filmLaenge(), fps: FILM_FPS, layout: filmLayout, uhr: (b) => ({ ...filmUhren()[b] }), phase: filmPhase },
    flug: { art: 'flug', quelle: 'kosmos-flug', fps: FLUG_FPS, maske: true, ...flugSeite }, // ab dem Einstieg, wo die Sterne heranrasen
  };
  import { erzeugeFilmsteuerung } from '../scripts/kosmos/filmsteuerung';
  import { erzeugeDurchsicht, type Art } from '../scripts/kosmos/durchsicht';


  document.querySelectorAll<HTMLElement>('[data-kosmos]').forEach((host, nr) => {
    const spr = sprache(host.dataset.sprache ?? document.documentElement.lang);
    const szene = baueSzene(host, nr, spr);
    const setzeStrich = () => szene.setzeStrich(parseFloat(getComputedStyle(host).getPropertyValue('--rx-dick')) || 1);

    /* Bei "Bewegung reduzieren" steht die Radix still */
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setzeStrich();
      szene.zeichne(layout(0, 1, ASC0));
      document.addEventListener('themechange', setzeStrich);
      return;
    }

    let uhr: Uhr = { t: 0, tau: 0 };
    const richtungen: Richtungen = new Map();

    /* Scrollgesteuert: Oben steht die fertige Radix. Ab der Startüberschrift löst sie sich beim Runterscrollen
       einmal ins Sonnensystem auf und bleibt so. Rückwärts scrollen spult zurück. */
    const bereich = host.dataset.scroll !== undefined ? host.closest<HTMLElement>('section') : null;
    const start = host.dataset.scrollStart ? bereich?.querySelector<HTMLElement>(host.dataset.scrollStart) : null;
    const scrollPhase = () => {
      const r = bereich!.getBoundingClientRect();
      // Beginn: die Startüberschrift erreicht 60 % der Fensterhöhe; Ende: das Abschnittsende erreicht 90 %
      const oben = start ? start.getBoundingClientRect().top : r.top;
      const weg = Math.max(1, r.bottom - oben - innerHeight * 0.3);
      const s = Math.min(1, Math.max(0, (innerHeight * 0.6 - oben) / weg));
      return 1 - glatt(s);
    };
    /* Mit Film: Nach dem Film (oder seinem Ersatz, der Live-Verwandlung) bleibt die Radix stehen */
    const mitFilm = host.dataset.film !== undefined && !bereich;
    const welcher = FILME[host.dataset.film ?? ''] ?? FILME.kosmos;
    let radixFest = false;
    const aktuellePhase = () => (bereich ? scrollPhase() : radixFest ? 1 : phase(uhr.t + EINSTIEG));

    /* Kosmos-Film: Video auf Schwarz bzw. Weiß, per WebGL durchsichtig gerechnet. Währenddessen sind die
       Ebenen der Live-Radix verborgen, rechnen aber im Takt der Videozeit mit (fliegende Sterne). */
    let film: {
      video: HTMLVideoElement;
      canvas: HTMLCanvasElement;
      durchsicht: NonNullable<ReturnType<typeof erzeugeDurchsicht>>;
      steuerung: ReturnType<typeof erzeugeFilmsteuerung>;
      fehler: boolean;
    } | null = null;
    const fassung = () => {
      const t = document.documentElement.dataset.theme;
      if (t === 'dark' || t === 'light') return t === 'dark' ? 'dunkel' : 'hell';
      return matchMedia('(prefers-color-scheme: dark)').matches ? 'dunkel' : 'hell';
    };
    const grund = (): Art => (welcher.maske ? 'maske' : fassung() === 'dunkel' ? 'schwarz' : 'weiss');
    const quelle = () => `/video/${welcher.quelle}-${fassung()}-${spr}${welcher.maske ? '-alpha' : ''}`;
    /* In der letzten Filmsekunde liegt die Live-Radix schon bildgenau unter dem Film, dann blendet der Film aus:
       So sieht man keinen Wechsel, auch wenn die Videokompression die feinen Goldlinien leicht verändert. */
    const UEBERBLENDEN = 1.2; // Sekunden
    /* Film beenden: bei 'uebergabe' übernimmt die Live-Radix den Stand des letzten Filmbilds und bleibt;
       bei einem Abbruch geht es live genau ab dem gezeigten Bild weiter. Beides blendet weich über. */
    const beendeFilm = (bild: number) => {
      if (!film) return;
      const { video, canvas, durchsicht } = film;
      film = null;
      uhr = welcher.uhr(bild);
      radixFest = welcher.phase(bild) === 1;
      host.classList.remove('kx-im-film');
      host.removeAttribute('data-film-art');
      host.removeAttribute('data-film-ende');
      canvas.style.opacity = '0';
      setTimeout(() => { canvas.remove(); durchsicht.frei(); }, 600);
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.remove();
    };
    const starteFilm = () => {
      const canvas = document.createElement('canvas');
      canvas.className = 'kx-film';
      canvas.setAttribute('aria-hidden', 'true');
      const durchsicht = erzeugeDurchsicht(canvas, grund());
      if (!durchsicht) return; // ohne WebGL: Live-Verwandlung
      const video = document.createElement('video');
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('aria-hidden', 'true');
      video.className = 'kx-film-quelle';
      video.src = `${quelle()}.mp4`;
      const zeichenEbene = host.querySelector('.kx-ebene-zeichen');
      host.insertBefore(video, zeichenEbene);
      host.appendChild(canvas); // über allen Live-Ebenen, damit sie am Ende darunter einblenden können
      host.classList.add('kx-im-film');
      host.dataset.filmArt = welcher.art;
      film = { video, canvas, durchsicht, steuerung: erzeugeFilmsteuerung(welcher.laenge, welcher.fps), fehler: false };
      const f = film;
      // Bis das Video läuft, steht sein erstes Bild da
      const vorschau = new Image();
      vorschau.onload = () => { if (film === f && !f.steuerung.gestartet()) durchsicht.zeichne(vorschau); };
      vorschau.src = `${quelle()}-anfang.jpg`;
      video.addEventListener('error', () => { f.fehler = true; });
      // Abspielen startet erst, wenn die Seite sichtbar ist (pruefe); Fristen und Ausweichen regelt die Steuerung
    };
    const filmBild = () => {
      const f = film;
      if (!f) return false;
      const v = f.video;
      const d = f.steuerung.schritt({
        jetzt: performance.now(), zeit: v.currentTime, bereit: v.readyState >= 2 && !v.seeking, ende: v.ended, fehler: f.fehler,
      });
      if (d.art === 'uebergabe') { beendeFilm(welcher.laenge - 1); return false; }
      if (d.art === 'live') { beendeFilm(d.bild); return false; }
      szene.zeichne(welcher.layout(d.bild));
      if (d.art === 'zeichnen') f.durchsicht.zeichne(v);
      // Übergabe vorbereiten: Live-Ebenen unter dem Film einblenden, danach den Film ausblenden
      const ab = welcher.laenge - 1 - UEBERBLENDEN * welcher.fps;
      if (d.art === 'zeichnen' && d.bild >= ab) {
        host.classList.remove('kx-im-film');
        host.dataset.filmEnde = ''; // Live-Himmel blendet ein, während der Film mit seinen Sternen ausblendet
        const q = (d.bild - ab) / (UEBERBLENDEN * welcher.fps);
        f.canvas.style.transition = 'none';
        f.canvas.style.opacity = (q < 0.45 ? 1 : Math.max(0, 1 - (q - 0.45) / 0.55)).toFixed(3);
      }
      return true;
    };

    const bild = () => {
      if (filmBild()) return;
      szene.zeichne(layout(uhr.tau, aktuellePhase(), aszendent(uhr.t), richtungen));
    };

    /* Läuft nur, solange das Rad sichtbar und der Tab im Vordergrund ist */
    let last: number | null = null, raf = 0, laeuft = false, imBild = false;
    const loop = (ts: number) => {
      if (last !== null) {
        // ruhiges Tempo, passend zu den langsam aufglimmenden Überschriften
        const dt = ((ts - last) / 1000) * TEMPO_SEITE;
        if (bereich || radixFest) {
          // Planeten laufen weiter, im Tempo passend zum Verwandlungsgrad
          const d = Math.min(Math.max(dt, 0), 0.1);
          uhr = { t: uhr.t + d, tau: uhr.tau + tempo(aktuellePhase()) * d };
        } else if (!film) {
          uhr = schritt(uhr, dt);
          // Live-Verwandlung als Ersatz für den Film: angekommen in der Radix, bleibt sie
          if (mitFilm && phase(uhr.t + EINSTIEG) === 1) radixFest = true;
        }
      }
      last = ts;
      bild();
      raf = requestAnimationFrame(loop);
    };
    const pruefe = () => {
      const soll = imBild && document.visibilityState === 'visible';
      // Der Film spielt nur, solange er zu sehen ist; ob er in Gang kommt, prüft die Filmsteuerung
      if (soll) film?.video.play().catch(() => {});
      else film?.video.pause();
      if (soll && !laeuft) { laeuft = true; last = null; raf = requestAnimationFrame(loop); }
      if (!soll && laeuft) { laeuft = false; cancelAnimationFrame(raf); }
    };

    /* Hell/dunkel mitten im Film: die andere Fassung an derselben Stelle weiter */
    const wechsleFassung = () => {
      if (!film) return;
      const { video, durchsicht } = film;
      const zeit = video.currentTime;
      durchsicht.setzeGrund(grund());
      video.src = `${quelle()}.mp4`;
      video.addEventListener('loadedmetadata', () => { video.currentTime = zeit; if (document.visibilityState === 'visible') video.play().catch(() => {}); }, { once: true });
    };

    const sparen = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (mitFilm && !sparen) starteFilm();

    setzeStrich();
    bild();
    document.addEventListener('themechange', () => { setzeStrich(); wechsleFassung(); });
    document.addEventListener('visibilitychange', pruefe);
    new IntersectionObserver((e) => { imBild = e[0].isIntersecting; pruefe(); }).observe(host);
  });
</script>

<style>
  /* Farben wie in den Horoskop-PDFs */
  .radix {
    --rx-gold: #9a7a33; /* Linien im Deckblatt-Gold des hellen PDFs; die Papierstruktur trägt das hellere Gold */
    --rx-text: #96762f; /* Schrift und Zeichen wie im hellen PDF */
    --rx-dick: 1.6; /* Linienstärke: Faktor gegenüber der dunklen Fassung */
    --rx-schnitt: 500; /* Schriftstärke */
    --rx-disk: #fefcf8; /* helles Creme innerhalb des Rads, hebt die Radix sanft vom Weiß ab */
    --kx-nabe: #ffffff; /* innerer Kreis der Radix weiß */
    /* Sonnensystem */
    --kx-stern: #9e7a2e; /* Sterngold wie im hellen PDF */
    --kx-stern-deckkraft: 0.65;
    --kx-sterne: inline; /* hell mit dezenten goldenen Sternen */
    --kx-funken-deckkraft: 0.85;
    --kx-nebel3: transparent;
    --kx-schatten: #5a4a35;
    --kx-schleier: #f3e6c8;
    --kx-nebel1: transparent;
    --kx-nebel2: transparent;
    --kx-hof: #e8a93c;
    --kx-hof-o: 0.55;
    --kx-hof2: #e3a347;
    --kx-hof2-o: 0.22;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    color: var(--rx-gold);
  }
  :global(:root[data-theme='dark']) .radix {
    --rx-gold: #e0c27e;
    --rx-text: #e0c27e;
    --rx-dick: 1;
    --rx-schnitt: 400;
    --rx-disk: rgb(7 16 42 / 0.5);
    --kx-nabe: transparent;
    --kx-stern: #eee7d7;
    --kx-stern-deckkraft: 1;
    --kx-sterne: inline;
    --kx-funken-deckkraft: 0.9;
    --kx-schatten: #0a0f22;
    --kx-schleier: transparent;
    --kx-nebel1: #4a3560;
    --kx-nebel2: #5a4420;
    --kx-nebel3: #1d3a6e;
    --kx-hof: #ffcf6e;
    --kx-hof-o: 0.65;
    --kx-hof2: #e0a240;
    --kx-hof2-o: 0.24;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .radix {
      --rx-gold: #e0c27e;
      --rx-text: #e0c27e;
      --rx-dick: 1;
      --rx-schnitt: 400;
      --rx-disk: rgb(7 16 42 / 0.5);
      --kx-nabe: transparent;
    --kx-nabe: transparent;
      --kx-stern: #eee7d7;
      --kx-stern-deckkraft: 1;
      --kx-sterne: inline;
      --kx-funken-deckkraft: 0.9;
      --kx-schatten: #0a0f22;
      --kx-schleier: transparent;
      --kx-nebel1: #4a3560;
      --kx-nebel2: #5a4420;
      --kx-nebel3: #1d3a6e;
      --kx-hof: #ffcf6e;
      --kx-hof-o: 0.65;
      --kx-hof2: #e0a240;
      --kx-hof2-o: 0.24;
    }
  }
  /* Kosmos-Film: liegt über der Radix, bis die Live-Radix übernimmt. Die Ebenen der Live-Radix sind solange
     verborgen (filter statt opacity, weil der Ring seine Deckkraft selbst setzt); Himmel und Sterne bleiben. */
  .radix :global(.kx-film) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  /* Quellvideo vollflächig und kaum sichtbar hinter der Leinwand: als unsichtbar erkannte Videos
     pausieren manche Browser (iPhone), so bleibt es abspielbereit */
  /* Kosmos-Flug: Der Film zeigt rings um das Rad die Galaxie, er ist um 1/0,8 größer als das Rad.
     Sein Rand läuft weich in die Seite aus. Der Live-Himmel ruht, solange der Film eigene Sterne bringt. */
  .radix[data-film-art='flug'] :global(.kx-film) {
    inset: -12.5%;
    width: 125%;
    height: 125%;
    -webkit-mask-image: radial-gradient(circle closest-side, #000 70%, rgb(0 0 0 / 0.55) 88%, transparent 100%);
    mask-image: radial-gradient(circle closest-side, #000 70%, rgb(0 0 0 / 0.55) 88%, transparent 100%);
  }
  .radix[data-film-art='flug']:not([data-film-ende]) :global(.kx-ebene-himmel),
  .radix[data-film-art='flug']:not([data-film-ende]) :global(.kx-ebene-funken) {
    opacity: 0;
  }
  .radix[data-film-ende] :global(.kx-ebene-himmel),
  .radix[data-film-ende] :global(.kx-ebene-funken) {
    transition: opacity 1.2s ease;
  }
  .radix:not([data-film-art]) :global(.kx-ebene-himmel),
  .radix:not([data-film-art]) :global(.kx-ebene-funken) {
    transition: opacity 1.2s ease;
  }
  .radix :global(.kx-film-quelle) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.001;
    pointer-events: none;
  }
  /* Beim Filmstart verschwinden die Live-Ebenen sofort, am Filmende blenden sie weich ein */
  .radix:not(:global(.kx-im-film)) :global(.kx-ebene-ring),
  .radix:not(:global(.kx-im-film)) :global(.kx-ebene-haupt),
  .radix:not(:global(.kx-im-film)) :global(.kx-ebene-zeichen) {
    transition: filter 0.5s ease;
  }
  .radix:global(.kx-im-film) :global(.kx-ebene-ring),
  .radix:global(.kx-im-film) :global(.kx-ebene-haupt),
  .radix:global(.kx-im-film) :global(.kx-ebene-zeichen) {
    filter: opacity(0);
  }
  /* Drei Ebenen übereinander: Himmel, Tierkreis-Ring, alles Bewegte */
  .radix :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  /* Der Ring dreht sich auf der Grafikkarte, ohne neu gezeichnet zu werden */
  .radix :global(.kx-ebene-ring) {
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  /* Hinausfliegende Sterne: hinter allem, auch hinter dem Text, über den ganzen ersten Bildschirm */
  .radix :global(.kx-ebene-funken) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    z-index: -1;
    pointer-events: none;
  }
  .radix :global(.kx-funke) {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform, opacity;
  }
  .radix :global(.kx-funke-licht) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--kx-stern);
    opacity: var(--kx-funken-deckkraft);
    box-shadow: 0 0 3px var(--kx-stern);
  }
  /* Bewegliche Zeichen: eigene Elemente, die Grafikkarte verschiebt sie stufenlos */
  .radix :global(.kx-ebene-zeichen) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .radix :global(.kx-zeichen) {
    position: absolute;
    left: 50%;
    top: 50%;
    line-height: 1;
    white-space: nowrap;
    color: var(--rx-text);
    font-weight: var(--rx-schnitt);
    font-family: 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'STIX Two Text', 'Segoe UI Symbol', 'Apple Symbols', serif;
    user-select: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .radix :global(.kx-zeichen.rx-zeichen) {
    font-size: calc(24 * var(--kx-einheit, 1px));
  }
  .radix :global(.kx-zeichen.rx-planet) {
    font-size: calc(29 * var(--kx-einheit, 1px));
  }
  .radix :global(.kx-zeichen.rx-planet.gross) {
    font-size: calc(32 * var(--kx-einheit, 1px));
  }
  /* Der Himmel läuft zum Rand weich ins Durchsichtige aus, keine Kante zur Seite */
  .radix :global(.kx-ebene-himmel) {
    will-change: transform;
    -webkit-mask-image: radial-gradient(circle closest-side, #000 30%, rgb(0 0 0 / 0.35) 70%, transparent 100%);
    mask-image: radial-gradient(circle closest-side, #000 30%, rgb(0 0 0 / 0.35) 70%, transparent 100%);
  }
  .radix :global(.kx-sterne) {
    display: var(--kx-sterne);
    fill: var(--kx-stern);
    opacity: var(--kx-stern-deckkraft);
  }
  .radix :global(.kx-funkeln) {
    animation: kx-funkeln 5s ease-in-out infinite;
  }
  @keyframes kx-funkeln {
    0%, 100% { opacity: var(--o); }
    50% { opacity: calc(var(--o) * 0.25); }
  }
  /* Atmender Himmel: Sternebenen treiben verschieden weit, Nebel treiben und atmen */
  .radix :global(.kx-ebene1) { animation: kx-treiben1 90s ease-in-out infinite alternate; }
  .radix :global(.kx-ebene2) { animation: kx-treiben2 70s ease-in-out infinite alternate; }
  .radix :global(.kx-ebene3) { animation: kx-treiben3 55s ease-in-out infinite alternate; }
  @keyframes kx-treiben1 { from { transform: translate(-6px, 2px); } to { transform: translate(6px, -2px); } }
  @keyframes kx-treiben2 { from { transform: translate(-12px, 4px); } to { transform: translate(12px, -4px); } }
  @keyframes kx-treiben3 { from { transform: translate(-20px, 7px); } to { transform: translate(20px, -7px); } }
  .radix :global(.kx-nebel-a) { animation: kx-nebel-a 47s ease-in-out infinite alternate; }
  .radix :global(.kx-nebel-b) { animation: kx-nebel-b 61s ease-in-out infinite alternate; }
  .radix :global(.kx-nebel-c) { animation: kx-nebel-c 53s ease-in-out infinite alternate; }
  .radix :global(.kx-schleier) { animation: kx-atmen 14s ease-in-out infinite alternate; }
  @keyframes kx-nebel-a { from { transform: translate(-30px, 10px) rotate(-4deg); opacity: 0.7; } to { transform: translate(40px, -18px) rotate(3deg); opacity: 1; } }
  @keyframes kx-nebel-b { from { transform: translate(25px, -12px) rotate(3deg); opacity: 1; } to { transform: translate(-35px, 20px) rotate(-3deg); opacity: 0.65; } }
  @keyframes kx-nebel-c { from { transform: translate(0, 0) scale(0.95); opacity: 0.55; } to { transform: translate(-25px, 15px) scale(1.06); opacity: 1; } }
  @keyframes kx-atmen { from { opacity: 0.8; } to { opacity: 1; } }
  .radix :global(.kx-nebel), .radix :global(.kx-schleier) { transform-box: fill-box; transform-origin: center; }
