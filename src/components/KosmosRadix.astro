---
// Startseite: Sonnensystem, das sich endlos in die Radix verwandelt und zurück.
// Folgt der Ansicht der Seite (hell oder dunkel). Erfundene Konstellation, gehört zu keiner realen Person.
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/500.css';
import '@fontsource/noto-sans-symbols/400.css';
import '@fontsource/noto-sans-symbols-2/400.css';

interface Props {
  class?: string;
  /* Sprache der Tierkreisnamen, z. B. "en". Ohne Angabe gilt das lang der Seite. */
  lang?: string;
}
const { class: className, lang } = Astro.props;
---

<div class:list={['radix', className]} data-kosmos data-sprache={lang}></div>

<script>
  import { baueSzene } from '../scripts/kosmos/szene';
  import { layout, aszendent, ASC0, type Richtungen } from '../scripts/kosmos/layout';
  import { schritt, phase, EINSTIEG, type Uhr } from '../scripts/kosmos/zeitplan';
  import { sprache } from '../scripts/kosmos/texte';

  document.querySelectorAll<HTMLElement>('[data-kosmos]').forEach((host, nr) => {
    const szene = baueSzene(host, nr, sprache(host.dataset.sprache ?? document.documentElement.lang));
    const setzeStrich = () => szene.setzeStrich(parseFloat(getComputedStyle(host).getPropertyValue('--rx-dick')) || 1);

    /* Bei "Bewegung reduzieren" steht die Radix still */
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setzeStrich();
      szene.zeichne(layout(0, 1, ASC0));
      document.addEventListener('themechange', setzeStrich);
      return;
    }

    let uhr: Uhr = { t: 0, tau: 0 };
    const richtungen: Richtungen = new Map();
    const bild = () => szene.zeichne(layout(uhr.tau, phase(uhr.t + EINSTIEG), aszendent(uhr.t), richtungen));

    /* Läuft nur, solange das Rad sichtbar und der Tab im Vordergrund ist */
    let last: number | null = null, raf = 0, laeuft = false, imBild = false;
    const loop = (ts: number) => {
      if (last !== null) uhr = schritt(uhr, (ts - last) / 1000);
      last = ts;
      bild();
      raf = requestAnimationFrame(loop);
    };
    const pruefe = () => {
      const soll = imBild && document.visibilityState === 'visible';
      if (soll && !laeuft) { laeuft = true; last = null; raf = requestAnimationFrame(loop); }
      if (!soll && laeuft) { laeuft = false; cancelAnimationFrame(raf); }
    };

    setzeStrich();
    bild();
    document.addEventListener('themechange', setzeStrich);
    document.addEventListener('visibilitychange', pruefe);
    new IntersectionObserver((e) => { imBild = e[0].isIntersecting; pruefe(); }).observe(host);
  });
</script>

<style>
  /* Farben wie in den Horoskop-PDFs */
  .radix {
    --rx-gold: #86662a; /* Linien, etwas dunkler als auf dem Deckblatt, damit sie auf Weiß tragen */
    --rx-text: #5e4413; /* Schrift und Zeichen, dunkles Gold für gute Lesbarkeit */
    --rx-dick: 1.6; /* Linienstärke: Faktor gegenüber der dunklen Fassung */
    --rx-schnitt: 500; /* Schriftstärke */
    --rx-disk: #fefcf8; /* helles Creme innerhalb des Rads, hebt die Radix sanft vom Weiß ab */
    /* Sonnensystem */
    --kx-stern: #b8914a;
    --kx-stern-deckkraft: 0.45;
    --kx-sterne: none; /* hell bleibt clean, ohne Sterne */
    --kx-nebel3: transparent;
    --kx-schatten: #5a4a35;
    --kx-schleier: #f3e6c8;
    --kx-nebel1: transparent;
    --kx-nebel2: transparent;
    --kx-hof: #f0c870;
    --kx-hof-o: 0.5;
    --kx-hof2: #f0c870;
    --kx-hof2-o: 0.2;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    color: var(--rx-gold);
  }
  :global(:root[data-theme='dark']) .radix {
    --rx-gold: #e0c27e;
    --rx-text: #e0c27e;
    --rx-dick: 1;
    --rx-schnitt: 400;
    --rx-disk: rgb(7 16 42 / 0.5);
    --kx-stern: #eee7d7;
    --kx-stern-deckkraft: 1;
    --kx-sterne: inline;
    --kx-schatten: #0a0f22;
    --kx-schleier: transparent;
    --kx-nebel1: #4a3560;
    --kx-nebel2: #5a4420;
    --kx-nebel3: #1d3a6e;
    --kx-hof: #ffe9b0;
    --kx-hof-o: 0.55;
    --kx-hof2: #e0b860;
    --kx-hof2-o: 0.18;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .radix {
      --rx-gold: #e0c27e;
      --rx-text: #e0c27e;
      --rx-dick: 1;
      --rx-schnitt: 400;
      --rx-disk: rgb(7 16 42 / 0.5);
      --kx-stern: #eee7d7;
      --kx-stern-deckkraft: 1;
      --kx-sterne: inline;
      --kx-schatten: #0a0f22;
      --kx-schleier: transparent;
      --kx-nebel1: #4a3560;
      --kx-nebel2: #5a4420;
      --kx-nebel3: #1d3a6e;
      --kx-hof: #ffe9b0;
      --kx-hof-o: 0.55;
      --kx-hof2: #e0b860;
      --kx-hof2-o: 0.18;
    }
  }
  /* Drei Ebenen übereinander: Himmel, Tierkreis-Ring, alles Bewegte */
  .radix :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  /* Der Ring dreht sich auf der Grafikkarte, ohne neu gezeichnet zu werden */
  .radix :global(.kx-ebene-ring) {
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  /* Bewegliche Zeichen: eigene Elemente, die Grafikkarte verschiebt sie stufenlos */
  .radix :global(.kx-ebene-zeichen) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .radix :global(.kx-zeichen) {
    position: absolute;
    left: 50%;
    top: 50%;
    line-height: 1;
    white-space: nowrap;
    color: var(--rx-text);
    font-weight: var(--rx-schnitt);
    font-family: 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'STIX Two Text', 'Segoe UI Symbol', 'Apple Symbols', serif;
    user-select: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .radix :global(.kx-zeichen.rx-zeichen) {
    font-size: calc(24 * var(--kx-einheit, 1px));
  }
  .radix :global(.kx-zeichen.rx-planet) {
    font-size: calc(29 * var(--kx-einheit, 1px));
  }
  .radix :global(.kx-zeichen.rx-planet.gross) {
    font-size: calc(32 * var(--kx-einheit, 1px));
  }
  /* Der Himmel läuft zum Rand weich ins Durchsichtige aus, keine Kante zur Seite */
  .radix :global(.kx-ebene-himmel) {
    will-change: transform;
    -webkit-mask-image: radial-gradient(circle closest-side, #000 30%, rgb(0 0 0 / 0.35) 70%, transparent 100%);
    mask-image: radial-gradient(circle closest-side, #000 30%, rgb(0 0 0 / 0.35) 70%, transparent 100%);
  }
  .radix :global(.kx-sterne) {
    display: var(--kx-sterne);
    fill: var(--kx-stern);
    opacity: var(--kx-stern-deckkraft);
  }
  .radix :global(.kx-funkeln) {
    animation: kx-funkeln 5s ease-in-out infinite;
  }
  @keyframes kx-funkeln {
    0%, 100% { opacity: var(--o); }
    50% { opacity: calc(var(--o) * 0.25); }
  }
  /* Atmender Himmel: Sternebenen treiben verschieden weit, Nebel treiben und atmen */
  .radix :global(.kx-ebene1) { animation: kx-treiben1 90s ease-in-out infinite alternate; }
  .radix :global(.kx-ebene2) { animation: kx-treiben2 70s ease-in-out infinite alternate; }
  .radix :global(.kx-ebene3) { animation: kx-treiben3 55s ease-in-out infinite alternate; }
  @keyframes kx-treiben1 { from { transform: translate(-6px, 2px); } to { transform: translate(6px, -2px); } }
  @keyframes kx-treiben2 { from { transform: translate(-12px, 4px); } to { transform: translate(12px, -4px); } }
  @keyframes kx-treiben3 { from { transform: translate(-20px, 7px); } to { transform: translate(20px, -7px); } }
  .radix :global(.kx-nebel-a) { animation: kx-nebel-a 47s ease-in-out infinite alternate; }
  .radix :global(.kx-nebel-b) { animation: kx-nebel-b 61s ease-in-out infinite alternate; }
  .radix :global(.kx-nebel-c) { animation: kx-nebel-c 53s ease-in-out infinite alternate; }
  .radix :global(.kx-schleier) { animation: kx-atmen 14s ease-in-out infinite alternate; }
  @keyframes kx-nebel-a { from { transform: translate(-30px, 10px) rotate(-4deg); opacity: 0.7; } to { transform: translate(40px, -18px) rotate(3deg); opacity: 1; } }
  @keyframes kx-nebel-b { from { transform: translate(25px, -12px) rotate(3deg); opacity: 1; } to { transform: translate(-35px, 20px) rotate(-3deg); opacity: 0.65; } }
  @keyframes kx-nebel-c { from { transform: translate(0, 0) scale(0.95); opacity: 0.55; } to { transform: translate(-25px, 15px) scale(1.06); opacity: 1; } }
  @keyframes kx-atmen { from { opacity: 0.8; } to { opacity: 1; } }
  .radix :global(.kx-nebel), .radix :global(.kx-schleier) { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: reduce) {
    .radix :global(.kx-funkeln),
    .radix :global(.kx-ebene),
    .radix :global(.kx-nebel),
    .radix :global(.kx-schleier) {
      animation: none;
    }
  }
  .radix :global(text) {
    fill: var(--rx-text);
    font-weight: var(--rx-schnitt);
    text-anchor: middle;
    dominant-baseline: central;
    user-select: none;
    font-family: 'STIX Two Text', 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'Segoe UI Symbol', 'Apple Symbols', serif;
  }
  .radix :global(.rx-glyph) {
    font-family: 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'STIX Two Text', 'Segoe UI Symbol', 'Apple Symbols', serif;
  }
  .radix :global(.rx-name) {
    font-size: 16px;
    letter-spacing: 4.2px;
    dominant-baseline: auto;
  }
  .radix :global(.rx-achse) {
    font-size: 13px;
    letter-spacing: 2.4px;
  }
  .radix :global(.rx-haus) {
    font-size: 17px;
  }
  .radix :global(.rx-zeichen) {
    font-size: 24px;
  }
  .radix :global(.rx-planet) {
    font-size: 29px;
  }
  .radix :global(.rx-planet.gross) {
    font-size: 32px;
  }
</style>
