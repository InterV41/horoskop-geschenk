---
// Partnerschaftshoroskop: zwei Radixe nebeneinander zerfallen beim Runterscrollen zu Sand,
// der darunter die Doppelradix bildet. Zurückscrollen spult zurück. Erfundene Konstellationen.
// Slot "paar-nach": Inhalt zwischen Paar und Doppelradix; Standard-Slot: nach der Doppelradix.
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/500.css';
import '@fontsource/noto-sans-symbols/400.css';
import '@fontsource/noto-sans-symbols-2/400.css';
import { langFromPath } from '../i18n';
import { texte, sprache } from '../scripts/kosmos/texte';

const t = texte(sprache(langFromPath(Astro.url.pathname))).partner;
---

<div class="partner" data-partner>
  <div class="partner__paar" role="img" aria-label={t.paar}>
    <figure class="partner__person">
      <div class="radix" data-partner-rad="a"></div>
      <figcaption class="partner__karte" aria-hidden="true"><span class="partner__name">{t.a.name}</span><span>{t.a.datum}</span><span>{t.a.ort}</span></figcaption>
    </figure>
    <figure class="partner__person">
      <div class="radix" data-partner-rad="b"></div>
      <figcaption class="partner__karte" aria-hidden="true"><span class="partner__name">{t.b.name}</span><span>{t.b.datum}</span><span>{t.b.ort}</span></figcaption>
    </figure>
  </div>
  <div class="partner__text"><slot name="paar-nach" /></div>
  <!-- Bahn: Die Doppelradix bleibt hier beim Scrollen stehen, bis sie aus dem Sand fertig aufgebaut ist -->
  <div class="partner__bahn">
    <div class="partner__doppel">
      <div class="partner__rad"><div class="radix" data-partner-doppel></div></div>
      <p class="partner__karte partner__karte--paar" aria-hidden="true"><span class="partner__name">{t.paarName}</span></p>
    </div>
    <div class="partner__halt" aria-hidden="true"></div>
  </div>
  <div class="partner__text"><slot /></div>
  <canvas class="partner__sand" aria-hidden="true"></canvas>
</div>

<script>
  import { baueSzene } from '../scripts/kosmos/szene';
  import { layout, ASC0, ASC_V } from '../scripts/kosmos/layout';
  import { TEMPO_RADIX, teil } from '../scripts/kosmos/zeitplan';
  import { laengen, RADIX_REIHE } from '../scripts/kosmos/modell';
  import { sprache, texte } from '../scripts/kosmos/texte';
  import { TAU_A, TAU_B, ASC_VERSATZ_B } from '../scripts/partner/paar';
  import { fortschritt } from '../scripts/partner/fortschritt';
  import { erzeugeKoerner, kornOrt, maskeRad, maskeDoppel, type Geometrie, type Rad } from '../scripts/partner/sand';
  import { baueDoppel } from '../scripts/partner/doppel';

  document.querySelectorAll<HTMLElement>('[data-partner]').forEach((wurzel) => {
    const hostA = wurzel.querySelector<HTMLElement>('[data-partner-rad="a"]')!;
    const hostB = wurzel.querySelector<HTMLElement>('[data-partner-rad="b"]')!;
    const hostD = wurzel.querySelector<HTMLElement>('[data-partner-doppel]')!;
    const paar = wurzel.querySelector<HTMLElement>('.partner__paar')!;
    const bahn = wurzel.querySelector<HTMLElement>('.partner__bahn')!;
    const doppelBox = wurzel.querySelector<HTMLElement>('.partner__doppel')!;
    const leinwand = wurzel.querySelector<HTMLCanvasElement>('.partner__sand')!;
    const ctx = leinwand.getContext('2d')!;
    const sp = sprache(document.documentElement.lang);

    const szA = baueSzene(hostA, 101, sp, { nurRadix: true });
    const szB = baueSzene(hostB, 102, sp, { nurRadix: true });
    // A und B beschreibt das Paar als Ganzes
    for (const h of [hostA, hostB]) h.querySelectorAll('svg').forEach((s) => (s.removeAttribute('role'), s.setAttribute('aria-hidden', 'true')));
    const doppel = baueDoppel(hostD, 103, sp, texte(sp).partner.doppel);

    let farbe = '', korn = 1;
    const setzeStrich = () => {
      const stil = getComputedStyle(hostD);
      const f = parseFloat(stil.getPropertyValue('--rx-dick')) || 1;
      szA.setzeStrich(f); szB.setzeStrich(f); doppel.setzeStrich(f);
      // Sand mit eigener Farbe und Korngröße je Ansicht: auf Weiß braucht er mehr Kraft
      farbe = stil.getPropertyValue('--partner-sand').trim() || stil.color;
      korn = parseFloat(stil.getPropertyValue('--partner-korn')) || 1;
    };

    /* Bei "Bewegung reduzieren" stehen alle drei Räder fertig still, ohne Sand. Gilt auch, wenn es umgestellt wird. */
    const bewegung = matchMedia('(prefers-reduced-motion: reduce)');
    let ruhig = bewegung.matches;
    const TEMPO = 0.25;
    let t = 0, tauA = TAU_A, tauB = TAU_B;

    const koerner = erzeugeKoerner(innerWidth >= 640 ? 6000 : 3000, 11,
      RADIX_REIHE.map((r) => laengen(TAU_A)[r.id]), RADIX_REIHE.map((r) => laengen(TAU_B)[r.id]));
    const aus = { x: 0, y: 0, o: 0 };
    const rad = (r: DOMRect, asc: number): Rad => ({ cx: r.left + r.width / 2, cy: r.top + r.height / 2, massstab: r.width / 940, asc });

    /* Leinwand in Fenstergröße, höchstens doppelte Pixeldichte */
    let dpr = 1, sandLeer = true;
    let stickyTop = 0;
    const groesse = () => {
      stickyTop = parseFloat(getComputedStyle(doppelBox).top) || 0;
      dpr = Math.min(devicePixelRatio || 1, 2);
      leinwand.width = Math.round(innerWidth * dpr);
      leinwand.height = Math.round(innerHeight * dpr);
      // in Pixeln wie innerHeight: 100vh ist auf dem Handy höher, solange die Browserleiste steht
      leinwand.style.width = innerWidth + 'px';
      leinwand.style.height = innerHeight + 'px';
      sandLeer = true;
    };

    /* Zerfallskante: weich und wellig wie Sand. Ein hohes Maskenbild (dreimal so hoch wie das Rad),
       oben durchsichtig, unten deckend, die Kante mit Rauschen verbogen. Geschoben wird nur die Lage. */
    const RAND = `url("data:image/svg+xml,${encodeURIComponent(
      "<svg xmlns='http://www.w3.org/2000/svg' width='200' height='600' viewBox='0 0 200 600' preserveAspectRatio='none'>" +
      "<filter id='f' x='-0.2' y='-0.1' width='1.4' height='1.2'><feTurbulence type='fractalNoise' baseFrequency='0.04 0.025' numOctaves='2' seed='4'/>" +
      "<feDisplacementMap in='SourceGraphic' scale='46' xChannelSelector='R' yChannelSelector='G'/></filter>" +
      "<linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0.47' stop-opacity='0'/><stop offset='0.53'/></linearGradient>" +
      "<rect x='-40' y='-40' width='280' height='680' fill='url(#g)' filter='url(#f)'/></svg>",
    )}")`;
    const zerfall = (e: HTMLElement, m: number) => {
      if (m <= 0) { maske(e, null); return; }
      maske(e, RAND);
      // Kante läuft von 35 % über dem Rad bis 35 % unter das Rad: Lage im Maskenbild 0,925 → 0,075
      const lage = (92.5 - 85 * m).toFixed(2) + '%';
      e.style.maskSize = e.style.webkitMaskSize = '100% 300%';
      e.style.maskRepeat = e.style.webkitMaskRepeat = 'no-repeat';
      e.style.maskPosition = e.style.webkitMaskPosition = '0 ' + lage;
    };

    const maske = (e: HTMLElement, wert: string | null) => {
      const v = wert ?? '';
      if (e.style.maskImage === v) return;
      e.style.maskImage = v;
      e.style.webkitMaskImage = v;
    };

    function zeichneSand(s: number, g: Geometrie) {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, leinwand.width, leinwand.height);
      sandLeer = true;
      if (s <= 0 || s >= 1) return;
      sandLeer = false;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = farbe;
      for (const k of koerner) {
        kornOrt(k, s, g, aus);
        if (aus.o <= 0.01 || aus.y < -20 || aus.y > innerHeight + 20) continue;
        ctx.globalAlpha = aus.o;
        const kg = k.groesse * korn;
        ctx.fillRect(aus.x - kg / 2, aus.y - kg / 2, kg, kg);
      }
      ctx.globalAlpha = 1;
    }

    let umriss = '';
    function bild() {
      // erst alles messen, dann schreiben: sonst rechnet der Browser das Layout mehrmals pro Bild
      const rBahn = bahn.getBoundingClientRect(), hDoppel = doppelBox.offsetHeight;
      const rPaar = paar.getBoundingClientRect(), rA = hostA.getBoundingClientRect(), rB = hostB.getBoundingClientRect(), rD = hostD.getBoundingClientRect();
      const seitenRest = document.documentElement.scrollHeight - scrollY - innerHeight;
      const ascA = ASC0 + ASC_V * t, ascB = ascA + ASC_VERSATZ_B;
      szA.zeichne(layout(tauA, 1, ascA));
      szB.zeichne(layout(tauB, 1, ascB));

      let s = 1;
      // linear: jedes Korn bewegt sich ohnehin weich, so beginnt der Zerfall gleich mit dem Scrollen
      if (!ruhig) s = fortschritt({ paar: rPaar, bahn: rBahn, doppelHoehe: hDoppel, stickyTop, fensterHoehe: innerHeight, seitenRest, scrollY });
      doppel.zeichne(laengen(tauA), laengen(tauB), ascA, teil(s, 0.9, 1));

      /* Zerfall von oben nach unten */
      const m = ruhig ? 0 : maskeRad(s); // ruhig: A und B ganz, Doppelradix fertig
      zerfall(hostA, m); zerfall(hostB, m);
      // die Doppelradix entsteht aus Sand; die scharfe Zeichnung löst das Sandbild erst am Ende ab
      const d = maskeDoppel(s);
      const deck = d >= 1 ? '' : d.toFixed(3);
      if (hostD.style.opacity !== deck) hostD.style.opacity = deck;
      const u = (0.08 * (1 - d)).toFixed(3);
      if (u !== umriss) wurzel.style.setProperty('--partner-umriss', (umriss = u));

      if ((s > 0 && s < 1) || !sandLeer) zeichneSand(s, { a: rad(rA, ascA), b: rad(rB, ascB), doppel: rad(rD, ascA) });
    }

    setzeStrich();
    document.addEventListener('themechange', setzeStrich);
    groesse();
    addEventListener('resize', groesse);

    /* Läuft nur, solange ein Rad sichtbar und der Tab im Vordergrund ist */
    let last: number | null = null, raf = 0, laeuft = false;
    const sichtbar = new Set<Element>();
    const loop = (ts: number) => {
      if (last !== null) {
        const dt = Math.min(Math.max((ts - last) / 1000, 0), 0.1);
        // ruhiger als die Kosmos-Radix: ein Viertel ihres Tempos
        t += dt * TEMPO;
        tauA += TEMPO_RADIX * dt * TEMPO;
        tauB += TEMPO_RADIX * dt * TEMPO;
      }
      last = ts;
      bild();
      raf = requestAnimationFrame(loop);
    };
    const pruefe = () => {
      const soll = !ruhig && sichtbar.size > 0 && document.visibilityState === 'visible';
      if (soll && !laeuft) { laeuft = true; last = null; raf = requestAnimationFrame(loop); }
      if (!soll && laeuft) { laeuft = false; cancelAnimationFrame(raf); bild(); }
    };
    bild();
    document.addEventListener('visibilitychange', pruefe);
    bewegung.addEventListener('change', () => { ruhig = bewegung.matches; pruefe(); bild(); });
    /* Sand liegt zwischen den Rädern: weiterlaufen, solange der Bereich vom Paar bis zur Doppelradix im Bild ist */
    const io = new IntersectionObserver((es) => {
      for (const e of es) e.isIntersecting ? sichtbar.add(e.target) : sichtbar.delete(e.target);
      pruefe();
    });
    io.observe(wurzel);
  });
</script>

<style>
  .partner {
    --partner-umriss: 0.08;
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-24);
    width: 100%;
    min-width: 0;
    /* der gedrehte Tierkreisring ragt mit seinen Ecken über den Rand: nicht seitlich scrollen lassen */
    overflow-x: clip;
  }
  .partner__paar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 5vw, 64px);
    width: min(100%, 860px);
    margin-block: var(--s-16);
  }
  .partner__person {
    margin: 0;
    min-width: 0;
    display: grid;
    gap: var(--s-16);
    justify-items: center;
  }
  /* Name und Geburtsdaten wie auf dem Deckblatt des PDFs */
  .partner__karte {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin: 0;
    color: var(--akzent); /* im hellen Modus 6,2:1 auf Weiß, im dunklen wie bisher Gold */
    font-family: 'STIX Two Text', serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-align: center;
  }
  .partner__name {
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: 0.01em;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .partner__karte--paar {
    margin-top: var(--s-24);
  }
  @media (max-width: 639px) {
    .partner__karte { font-size: 11px; letter-spacing: 0.06em; }
  }
  .partner__text {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--s-16);
  }
  /* Fallstrecke für den Sand, danach die Bahn, in der die Doppelradix stehen bleibt */
  .partner__bahn {
    --partner-halt-oben: max(76px, 9vh);
    width: 100%;
    margin-top: clamp(100px, 35vh, 420px);
    margin-bottom: var(--s-32, 32px);
  }
  .partner__doppel {
    position: sticky;
    top: var(--partner-halt-oben);
    width: min(100%, 70%, calc(100vh - var(--partner-halt-oben) - 96px));
    margin-inline: auto;
  }
  /* so lange bleibt sie stehen, während der Sand landet */
  .partner__halt {
    height: 100vh;
  }
  .partner__rad {
    position: relative;
  }
  /* zarter Umriss, solange die Doppelradix noch nicht da ist */
  .partner__rad::before {
    content: '';
    position: absolute;
    inset: calc(50% - 44.5%);
    border: 1px solid var(--gold);
    border-radius: 50%;
    opacity: var(--partner-umriss);
    pointer-events: none;
  }
  @media (max-width: 639px) {
    .partner__paar { gap: 12px; }
    .partner__doppel { width: 100%; }
  }
  /* Sand: über den Rädern, unter dem Text */
  .partner__sand {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .partner__sand { display: none; }
  }

  /* Farben und Aufbau wie die Kosmos-Radix, ohne Himmel */
  .radix {
    --rx-gold: #86662a;
    --rx-text: #5e4413;
    --rx-dick: 1.6;
    --rx-schnitt: 500;
    --rx-disk: #fefcf8;
    --kx-nabe: #ffffff;
    --rx-partner: #4f6a86;
    --partner-sand: #6e5017;
    --partner-korn: 1.7;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    color: var(--rx-gold);
  }
  :global(:root[data-theme='dark']) .radix {
    --rx-gold: #e0c27e;
    --rx-text: #e0c27e;
    --rx-dick: 1;
    --rx-schnitt: 400;
    --rx-disk: rgb(7 16 42 / 0.5);
    --kx-nabe: transparent;
    --rx-partner: #9fc3d9;
    --partner-sand: #e0c27e;
    --partner-korn: 1;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .radix {
      --rx-gold: #e0c27e;
      --rx-text: #e0c27e;
      --rx-dick: 1;
      --rx-schnitt: 400;
      --rx-disk: rgb(7 16 42 / 0.5);
      --kx-nabe: transparent;
      --rx-partner: #9fc3d9;
      --partner-sand: #e0c27e;
      --partner-korn: 1;
      }
  }
  .radix :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .radix :global(.kx-ebene-ring) {
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .radix :global(.kx-ebene-zeichen) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .radix :global(.kx-zeichen) {
    position: absolute;
    left: 50%;
    top: 50%;
    line-height: 1;
    white-space: nowrap;
    color: var(--rx-text);
    font-weight: var(--rx-schnitt);
    font-family: 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'STIX Two Text', 'Segoe UI Symbol', 'Apple Symbols', serif;
    user-select: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .radix :global(.kx-zeichen.rx-zeichen) { font-size: calc(24 * var(--kx-einheit, 1px)); }
  .radix :global(.kx-zeichen.rx-planet) { font-size: calc(29 * var(--kx-einheit, 1px)); }
  .radix :global(.kx-zeichen.rx-planet.gross) { font-size: calc(32 * var(--kx-einheit, 1px)); }
  .radix :global(.kx-zeichen.rx-planet.klein) { font-size: calc(26 * var(--kx-einheit, 1px)); }
  .radix :global(.kx-zeichen.rx-partner) { color: var(--rx-partner); }
  .radix :global(text) {
    fill: var(--rx-text);
    font-weight: var(--rx-schnitt);
    text-anchor: middle;
    dominant-baseline: central;
    user-select: none;
    font-family: 'STIX Two Text', 'Noto Sans Symbols', 'Noto Sans Symbols 2', 'Segoe UI Symbol', 'Apple Symbols', serif;
  }
  .radix :global(.rx-name) { font-size: 16px; letter-spacing: 4.2px; dominant-baseline: auto; }
  .radix :global(.rx-achse) { font-size: 13px; letter-spacing: 2.4px; }
  .radix :global(.rx-haus) { font-size: 17px; }
</style>
