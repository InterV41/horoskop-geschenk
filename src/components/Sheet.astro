---
// Stilisierte PDF-Seite: Titelblatt oder Kapitelseite.
import ChartWheel from './ChartWheel.astro';

interface Props {
  kind: 'cover' | 'chapter';
  variant?: 'light' | 'dark';
  class?: string;
}
const { kind, variant, class: className } = Astro.props;
---

<div class:list={['sheet', `sheet--${kind}`, variant && `sheet--${variant}`, className]}>
  {kind === 'cover' ? (
    <>
      <p class="sheet__eyebrow">Geburtshoroskop</p>
      <p class="sheet__name">Vorname</p>
      <ChartWheel size={130} class="sheet__wheel" />
      <p class="sheet__meta">Datum · Uhrzeit · Ort</p>
    </>
  ) : (
    <>
      <p class="sheet__numeral">IV</p>
      <p class="sheet__title">Innenwelt</p>
      <p class="sheet__sub">Kernsatz des Kapitels</p>
      <div class="sheet__lines" aria-hidden="true">
        {Array.from({ length: 16 }, (_, i) => (
          <span style={`width:${i === 7 || i === 15 ? 70 : 92 + ((i * 7) % 8)}%`} />
        ))}
      </div>
    </>
  )}
</div>

<style>
  .sheet {
    --s-bg: var(--paper);
    --s-ink: var(--ink);
    --s-ink2: var(--ink-2);
    --s-accent: var(--accent);
    aspect-ratio: 1 / 1.414;
    width: 100%;
    background: var(--s-bg);
    color: var(--s-ink);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.35), 0 0 0 1px var(--line);
    padding: 12% 10%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: var(--font-display);
  }
  .sheet--light {
    --s-bg: #f7f2e8;
    --s-ink: #2a2520;
    --s-ink2: #5b5246;
    --s-accent: #7a5d20;
  }
  .sheet--dark {
    --s-bg: #0d1430;
    --s-ink: #eee7d7;
    --s-ink2: #b9b2a2;
    --s-accent: #d6b56e;
    background-image: radial-gradient(1px 1px at 20% 30%, #fff8 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 15%, #fff6 50%, transparent 51%),
      radial-gradient(1px 1px at 85% 60%, #fff5 50%, transparent 51%),
      radial-gradient(1px 1px at 35% 80%, #fff6 50%, transparent 51%);
  }
  .sheet__eyebrow {
    font-size: 0.55rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--s-accent);
    margin: 0;
  }
  .sheet__name {
    font-size: 1.5rem;
    margin: 0.4rem 0 0.8rem;
  }
  .sheet__wheel {
    color: var(--s-accent);
    width: 72%;
    height: auto;
  }
  .sheet__meta {
    margin-top: auto;
    font-size: 0.55rem;
    color: var(--s-ink2);
  }
  .sheet__numeral {
    font-size: 1.5rem;
    color: var(--s-accent);
    margin: 0;
  }
  .sheet__title {
    font-size: 1.05rem;
    margin: 0.2rem 0 0;
  }
  .sheet__sub {
    font-style: italic;
    font-size: 0.6rem;
    color: var(--s-ink2);
    margin: 0.2rem 0 1rem;
  }
  .sheet__lines {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }
  .sheet__lines span {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--s-ink2);
    opacity: 0.45;
  }
  .sheet__lines span:nth-child(8) {
    margin-bottom: 0.5rem;
  }
</style>
