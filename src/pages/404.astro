---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title={`Seite nicht gefunden | ${site.name}`} description="Diese Seite gibt es nicht." noindex>
  <section class="abschnitt wrap mitte">
    <h1>Diese Seite gibt es nicht.</h1>
    <p class="nebentext abstand-16">Vielleicht hilft dir die <a class="textlink" href="/">Startseite</a> weiter.</p>
    <p class="nebentext abstand-16" lang="en">This page does not exist. Go to the <a class="textlink" href="/en">English home page</a>.</p>
  </section>
</Base>

<style>
  .abstand-16 {
    margin-top: var(--s-16);
  }
</style>
