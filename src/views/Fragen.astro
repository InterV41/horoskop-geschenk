---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import tempelBild from '../assets/geschichte/hathor-tempel-dendera-saeulenhalle.jpg';
import { gruppen, alleFragen } from '../data/fragen';
import { artikelListe, pfadVon } from '../data/ratgeber';
import { langFromPath, routes } from '../i18n';
import { anbieter } from '../site';

const lang = langFromPath(Astro.url.pathname);
const T = {
  de: {
    title: 'Fragen zum Geburtshoroskop: Geburtszeit, Lieferzeit, PDF',
    description: 'Antworten zum Geburtshoroskop: was bei unbekannter Geburtszeit passiert, wo du sie findest, wie schnell das PDF kommt und wie die Texte entstehen.',
    crumb: 'FAQ', h1: 'Fragen zum Geburtshoroskop',
    ausfuehrlich: 'Ausführlich erklärt', weiter: 'Weiterlesen', entwurf: 'Entwurf',
    geschichte: {
      gruppe: 'Geschichte der Astrologie',
      bildAlt: 'Säulenhalle des Hathor-Tempels von Dendera mit bemalter Decke',
      link: 'Zur Geschichte der Astrologie',
      frage: 'Woher kommt die Astrologie?',
      teaser: 'Von den Sternenuhren Ägyptens über Babylon und Ptolemäus bis zum heutigen Geburtshoroskop: die Geschichte der Astrologie im Überblick.',
    },
    kontakt: 'Kontakt',
    kontaktText: 'Deine Frage war nicht dabei? Schreib uns eine Mail. Wir lesen jede Nachricht und antworten persönlich.',
    kontaktKnopf: 'E-Mail schreiben',
  },
  en: {
    title: 'Birth Chart FAQ: birth time, delivery, PDF',
    description: 'Answers about the birth chart: what happens if the birth time is unknown, where to find it, how quickly the PDF arrives and how the texts are created.',
    crumb: 'FAQ', h1: 'Questions about the birth chart',
    ausfuehrlich: 'Explained in depth', weiter: 'Read more', entwurf: 'draft',
    geschichte: {
      gruppe: 'History of astrology',
      bildAlt: 'Hypostyle hall of the Temple of Hathor at Dendera with its painted ceiling',
      link: 'Read the history of astrology',
      frage: 'Where does astrology come from?',
      teaser: 'From the star clocks of Egypt via Babylon and Ptolemy to the birth chart of today: the history of astrology at a glance.',
    },
    kontakt: 'Contact',
    kontaktText: 'Your question was not answered here? Send us an email. We read every message and reply personally.',
    kontaktKnopf: 'Write an email',
  },
};
const t = T[lang];
const artikel = await artikelListe(lang);

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: alleFragen(lang).map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};
---

<Base
  title={t.title}
  description={t.description}
  breadcrumbs={[{ name: t.crumb, path: routes.fragen[lang] }]}
  jsonLd={[faq]}
>
  <section class="abschnitt wrap">
    <h1 class="kopf">{t.h1}</h1>
    <div class="gruppen">
      {/* Die Geschichte der Astrologie als erster Block, mit Bild */}
      <section class="gruppe" id="geschichte" aria-label={t.geschichte.gruppe}>
        <h2 class="etikett gruppe__titel">{t.geschichte.gruppe}</h2>
        <a class="geschichte" href={routes.geschichte[lang]}>
          <Image class="geschichte__bild" src={tempelBild} alt={t.geschichte.bildAlt} widths={[400, 720]} sizes="(max-width: 720px) 100vw, 360px" format="webp" quality={76} loading="lazy" />
          <div class="geschichte__text">
            <p class="nebentext">{t.geschichte.teaser}</p>
            <span class="artikel__weiter">{t.geschichte.link} →</span>
          </div>
        </a>
      </section>
      {gruppen[lang].map((g) => (
        <section class="gruppe" id={g.anker} aria-label={g.titel}>
          <h2 class="etikett gruppe__titel">{g.titel}</h2>
          <div class="rahmen">
            {g.fragen.map((f) => (
              <details>
                <summary><h3>{f.frage}</h3></summary>
                <div class="antwort">
                  {f.antwort.split('\n\n').map((absatz) => <p>{absatz}</p>)}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
      <section class="gruppe" aria-label={t.ausfuehrlich}>
          <h2 class="etikett gruppe__titel">{t.ausfuehrlich}</h2>
          <ul class="artikel rahmen">
            {artikel.map((a) => (
              <li>
                <a href={pfadVon(a)}>
                  <h3>{a.data.frage}{a.data.draft && <span class="nebentext klein"> ({t.entwurf})</span>}</h3>
                  <p class="nebentext">{a.data.teaser}</p>
                  <span class="artikel__weiter">{t.weiter} →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
    </div>
  </section>
  {/* Kontaktfeld ganz unten auf der Seite, Ziel von „Kontakt“ im Menü */}
  <section class="abschnitt" id="kontakt">
    <div class="wrap">
     <div class="kontakt">
      <h2>{t.kontakt}</h2>
      <p class="nebentext">{t.kontaktText}</p>
      <p class="kontakt__adresse"><a href={`mailto:${anbieter.email}`}>{anbieter.email}</a></p>
      <a class="knopf" href={`mailto:${anbieter.email}`}>{t.kontaktKnopf}</a>
     </div>
    </div>
  </section>
</Base>

<style>
  /* Block Geschichte: Bild links, Text rechts, als Ganzes klickbar */
  .geschichte {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: center;
    gap: var(--s-32);
    margin-top: var(--s-24);
    padding: var(--s-16);
    border: 1px solid var(--karte-rand);
    border-radius: 28px;
    background: var(--karte);
    box-shadow: var(--karte-licht);
    backdrop-filter: var(--karte-blur);
    -webkit-backdrop-filter: var(--karte-blur);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .geschichte:hover {
    border-color: color-mix(in srgb, var(--gold) 60%, transparent);
  }
  .geschichte:hover h3 {
    color: var(--akzent);
  }
  .geschichte :global(.geschichte__bild) {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 260px;
    object-fit: cover;
    border-radius: 18px;
  }
  .geschichte__text {
    padding-right: var(--s-16);
  }
  .geschichte__text h3 {
    margin-bottom: var(--s-8);
    transition: color 0.2s;
  }
  .geschichte__text .artikel__weiter {
    display: inline-block;
    margin-top: var(--s-16);
  }
  @media (max-width: 720px) {
    .geschichte {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-16);
    }
    .geschichte :global(.geschichte__bild) {
      max-height: 200px;
    }
    .geschichte__text {
      padding: 0 var(--s-8) var(--s-8);
    }
  }
  /* Kontaktfeld: ruhige Glasfläche, mittig */
  .kontakt {
    max-width: 640px;
    padding: var(--s-48) var(--s-32);
    border: 1px solid var(--karte-rand);
    border-radius: 32px;
    background: var(--karte);
    box-shadow: var(--karte-licht);
    backdrop-filter: var(--karte-blur);
    -webkit-backdrop-filter: var(--karte-blur);
    scroll-margin-top: 110px;
  }
  .kontakt h2 {
    margin-bottom: var(--s-16);
  }
  .kontakt__adresse {
    margin-block: var(--s-24);
    font-family: var(--font-titel);
    font-size: var(--t-13);
    font-weight: 700;
  }
  .kontakt__adresse a {
    color: var(--akzent);
    text-decoration: none;
  }
  .kontakt__adresse a:hover {
    text-decoration: underline;
  }
  #kontakt,
  .gruppe {
    scroll-margin-top: 90px;
  }
  /* Kopf: linksbündig mit kurzem Goldstrich */
  .kopf::after {
    content: '';
    display: block;
    width: 48px;
    height: 1px;
    margin: var(--s-24) 0 0;
    background: var(--gold);
  }
  .gruppen {
    max-width: var(--zeile);
    margin-top: var(--s-48);
    display: grid;
    gap: var(--s-48);
  }
  /* Abschnittsüberschriften groß und fett, deutlich über den einzelnen Fragen */
  .gruppe__titel {
    font-family: var(--font-titel);
    font-size: 2rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: normal;
    text-transform: none;
    color: var(--titel);
    margin-bottom: var(--s-16);
  }
  /* Jede Gruppe in einem Rahmen wie der Block zur Geschichte */
  .rahmen {
    margin: var(--s-24) 0 0;
    padding: var(--s-8) var(--s-32);
    border: 1px solid var(--karte-rand);
    border-radius: 28px;
    background: var(--karte);
    box-shadow: var(--karte-licht);
    backdrop-filter: var(--karte-blur);
    -webkit-backdrop-filter: var(--karte-blur);
  }
  details {
    border-bottom: 1px solid var(--linie);
  }
  details:last-of-type {
    border-bottom: 0;
  }
  @media (max-width: 520px) {
    .rahmen {
      padding: var(--s-4) var(--s-16);
      border-radius: 22px;
    }
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-16);
    min-height: 56px;
    padding-block: var(--s-12);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--font-titel);
    font-size: var(--t-17);
    color: var(--akzent);
    flex: none;
  }
  details[open] summary::after {
    content: '−';
  }
  summary h3 {
    font-size: var(--t-13);
  }
  .antwort {
    padding-bottom: var(--s-24);
    color: var(--tinte2);
  }
  .antwort p + p {
    margin-top: var(--s-12);
  }
  /* Ausführliche Antworten: eigene Seiten, deshalb als Links statt zum Aufklappen */
  .artikel {
    list-style: none;
  }
  .artikel li + li {
    border-top: 1px solid var(--linie);
  }
  .artikel a {
    display: block;
    padding-block: var(--s-16) var(--s-24);
    text-decoration: none;
    color: inherit;
  }
  .artikel h3 {
    font-size: var(--t-13);
    margin-bottom: var(--s-8);
  }
  .artikel a:hover h3 {
    color: var(--akzent);
  }
  .artikel__weiter {
    display: inline-block;
    margin-top: var(--s-8);
    font-family: var(--font-titel);
    font-style: italic;
    color: var(--akzent);
  }
</style>
