// Cloudflare: reine statische Auslieferung aus dist/, kein Server-Code.
// Vorschau hochladen mit `npm run vorschau` (siehe scripts/vorschau.sh).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "horoskop-geschenk-vorschau",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
